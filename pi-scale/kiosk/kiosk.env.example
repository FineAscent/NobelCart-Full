# NobelCart kiosk — copy to /etc/nobelcart/kiosk.env and edit.
# Used by scale service + Chromium kiosk on boot.
# NEVER put real SUPABASE_SERVICE_ROLE_KEY in this example file.

# Folder on this Pi that contains scale_stream.py (and config.json)
PI_SCALE_DIR=/home/noblecart01/pi-scale

# Must match this cart's kiosk URL and config.json cart_id
CART_ID=cart-1

# Your live site entry page (no ?cart= — the launcher adds it)
SITE_URL=https://nobelcart-full-test-internal.onrender.com/signin.html

# Supabase service role (Pi only — set in /etc/nobelcart/kiosk.env)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: chromium binary override (auto-detected if empty)
# CHROMIUM_BIN=/usr/bin/chromium

# Optional: Linux user that owns the desktop session
KIOSK_USER=noblecart01
